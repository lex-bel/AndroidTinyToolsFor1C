+    // вызывается только под lock
+    private static void closeConnection() {
+        if (outStream != null) {
+            try {
+                outStream.close();
+            } catch (IOException ignored) {
+            }
+            outStream = null;
+        }
+        if (inStream != null) {
+            try {
+                inStream.close();
+            } catch (IOException ignored) {
+            }
+            inStream = null;
+        }
+        if (btSocket != null) {
+            try {
+                btSocket.close();
+            } catch (IOException ignored) {
+            }
+            btSocket = null;
+        }
+        if (tcpSocket != null) {
+            try {
+                tcpSocket.close();
+            } catch (IOException ignored) {
+            }
+            tcpSocket = null;
+        }
+    }
